        function createRobloxCharacter(headCol, torsoCol, limbCol) {
            const group = new THREE.Group();

            // Materials
            const headMat = new THREE.MeshToonMaterial({ color: headCol });
            const torsoMat = new THREE.MeshToonMaterial({ color: torsoCol });
            const limbMat = new THREE.MeshToonMaterial({ color: limbCol });

            // Torso (R6 Roblox proportional box)
            const torsoGeo = new THREE.BoxGeometry(1.6, 2.0, 1.0);
            torsoMesh = new THREE.Mesh(torsoGeo, torsoMat);
            torsoMesh.position.y = 2.0;
            torsoMesh.castShadow = true;
            group.add(torsoMesh);

            // Head (Blocky with Face texture fallback graphic)
            const headGeo = new THREE.BoxGeometry(1.2, 1.2, 1.2);
            headMesh = new THREE.Mesh(headGeo, headMat);
            headMesh.position.y = 1.6;
            headMesh.castShadow = true;
            torsoMesh.add(headMesh);

            // Face (Classic Roblox Smile Eyes Canvas Texture)
            const canvas = document.createElement('canvas');
            canvas.width = 128; canvas.height = 128;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#FFE033'; ctx.fillRect(0,0,128,128);
            // Eyes
            ctx.fillStyle = '#000000';
            ctx.fillRect(30, 35, 18, 28);
            ctx.fillRect(80, 35, 18, 28);
            // Smile
            ctx.beginPath();
            ctx.arc(64, 75, 30, 0.1 * Math.PI, 0.9 * Math.PI, false);
            ctx.lineWidth = 8;
            ctx.stroke();
            const faceTex = new THREE.CanvasTexture(canvas);
            const faceMat = new THREE.MeshBasicMaterial({ map: faceTex });
            const facePlane = new THREE.Mesh(new THREE.PlaneGeometry(0.9, 0.9), faceMat);
            facePlane.position.set(0, 0, 0.61);
            headMesh.add(facePlane);

            // Left Arm
            const armGeo = new THREE.BoxGeometry(0.75, 2.0, 0.75);
            armGeo.translate(0, -0.8, 0); // pivot at top
            leftArm = new THREE.Mesh(armGeo, limbMat);
            leftArm.position.set(-1.25, 0.9, 0);
            leftArm.castShadow = true;
            torsoMesh.add(leftArm);

            // Right Arm
            rightArm = new THREE.Mesh(armGeo, limbMat);
            rightArm.position.set(1.25, 0.9, 0);
            rightArm.castShadow = true;
            torsoMesh.add(rightArm);

            // Left Leg
            const legGeo = new THREE.BoxGeometry(0.75, 2.0, 0.75);
            legGeo.translate(0, -0.9, 0); // pivot at top
            leftLeg = new THREE.Mesh(legGeo, limbMat);
            leftLeg.position.set(-0.42, -1.0, 0);
            leftLeg.castShadow = true;
            torsoMesh.add(leftLeg);

            // Right Leg
            rightLeg = new THREE.Mesh(legGeo, limbMat);
            rightLeg.position.set(0.42, -1.0, 0);
            rightLeg.castShadow = true;
            torsoMesh.add(rightLeg);

            // Default Sword Weapon held in Right Arm
            weaponMesh = createSwordMesh();
            weaponMesh.position.set(0, -1.5, 0.6);
            weaponMesh.rotation.x = Math.PI / 2;
            rightArm.add(weaponMesh);

            return group;
        }

        function createSwordMesh() {
            const swordGroup = new THREE.Group();
            // Blade
            const bladeGeo = new THREE.BoxGeometry(0.2, 2.8, 0.1);
            const bladeMat = new THREE.MeshToonMaterial({ color: 0x00e5ff, emissive: 0x005577 });
            const blade = new THREE.Mesh(bladeGeo, bladeMat);
            blade.position.y = 1.4;
            swordGroup.add(blade);
            // Hilt
            const hiltGeo = new THREE.BoxGeometry(0.8, 0.15, 0.2);
            const hiltMat = new THREE.MeshToonMaterial({ color: 0xffcc00 });
            const hilt = new THREE.Mesh(hiltGeo, hiltMat);
            swordGroup.add(hilt);
            // Handle
            const handleGeo = new THREE.BoxGeometry(0.2, 0.6, 0.2);
            const handleMat = new THREE.MeshToonMaterial({ color: 0x553311 });
            const handle = new THREE.Mesh(handleGeo, handleMat);
            handle.position.y = -0.3;
            swordGroup.add(handle);

            return swordGroup;
        }

        function initScene() {
            const canvas = document.getElementById('game-canvas');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x7ec0ee); // Classic Roblox sky blue
            scene.fog = new THREE.FogExp2(0x7ec0ee, 0.012);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            
            renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(40, 80, 40);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 2048;
            dirLight.shadow.mapSize.height = 2048;
            dirLight.shadow.camera.near = 0.5;
            dirLight.shadow.camera.far = 200;
            const d = 60;
            dirLight.shadow.camera.left = -d;
            dirLight.shadow.camera.right = d;
            dirLight.shadow.camera.top = d;
            dirLight.shadow.camera.bottom = -d;
            scene.add(dirLight);

            // Construct Roblox World Map
            buildRobloxMap();

            // Player Setup
            player = createRobloxCharacter(selectedSkin.headColor, selectedSkin.torsoColor, selectedSkin.limbColor);
            scene.add(player);

            // Input Event Listeners
            setupInputs();
            window.addEventListener('resize', onWindowResize);
        }

        function buildRobloxMap() {
            // Bright green grass base stud floor
            const mapSize = 120;
            const floorGeo = new THREE.BoxGeometry(mapSize, 4, mapSize);
            const floorMat = new THREE.MeshToonMaterial({ color: 0x2e8b57 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.position.y = -2;
            floor.receiveShadow = true;
            scene.add(floor);

            // Add Roblox stud-like details/blocks around map
            const blockColors = [0xff3333, 0x3388ff, 0xffaa00, 0xaa33ff, 0x00e5ff];
            for (let i = 0; i < 45; i++) {
                const w = 2 + Math.random() * 4;
                const h = 2 + Math.random() * 8;
                const d = 2 + Math.random() * 4;
                const geo = new THREE.BoxGeometry(w, h, d);
                const mat = new THREE.MeshToonMaterial({ color: blockColors[Math.floor(Math.random() * blockColors.length)] });
                const block = new THREE.Mesh(geo, mat);
                
                const x = (Math.random() - 0.5) * (mapSize - 15);
                const z = (Math.random() - 0.5) * (mapSize - 15);
                if (Math.abs(x) < 10 && Math.abs(z) < 10) continue; // Keep center clear
                
                block.position.set(x, h / 2, z);
                block.castShadow = true;
                block.receiveShadow = true;
                scene.add(block);
            }

            // Blocky Trees
            for (let i = 0; i < 20; i++) {
                const treeGroup = new THREE.Group();
                // Trunk
                const trunk = new THREE.Mesh(
                    new THREE.BoxGeometry(1.2, 6, 1.2),
                    new THREE.MeshToonMaterial({ color: 0x8b4513 })
                );
                trunk.position.y = 3;
                trunk.castShadow = true;
                treeGroup.add(trunk);
                // Leaves (Cubical Roblox Style)
                const leaves = new THREE.Mesh(
                    new THREE.BoxGeometry(4.5, 4.5, 4.5),
                    new THREE.MeshToonMaterial({ color: 0x00ff66 })
                );
                leaves.position.y = 6.5;
                leaves.castShadow = true;
                treeGroup.add(leaves);

                const x = (Math.random() - 0.5) * (mapSize - 10);
                const z = (Math.random() - 0.5) * (mapSize - 10);
                if (Math.abs(x) < 12 && Math.abs(z) < 12) continue;
                treeGroup.position.set(x, 0, z);
                scene.add(treeGroup);
            }
        }

        function spawnEnemy() {
            const types = [
                { type: 'Zombie', color: 0x33aa33, head: 0x008800, hp: 40, speed: 5.5, size: 1.0, damage: 10, exp: 25 },
                { type: 'Noob', color: 0x00a2ff, head: 0xffe033, hp: 25, speed: 8.0, size: 0.9, damage: 6, exp: 15 },
                { type: 'Guest', color: 0x222222, head: 0xcccccc, hp: 90, speed: 4.5, size: 1.3, damage: 20, exp: 50 }
            ];

            const cfg = types[Math.floor(Math.random() * types.length)];
            const angle = Math.random() * Math.PI * 2;
            const dist = 30 + Math.random() * 15;
            const spawnX = player.position.x + Math.cos(angle) * dist;
            const spawnZ = player.position.z + Math.sin(angle) * dist;

            const enemyGroup = createRobloxCharacter(cfg.head, cfg.color, 0x111111);
            enemyGroup.scale.set(cfg.size, cfg.size, cfg.size);
            enemyGroup.position.set(spawnX, 0, spawnZ);

            scene.add(enemyGroup);

            enemies.push({
                mesh: enemyGroup,
                hp: cfg.hp * (1 + currentWave * 0.2),
                maxHp: cfg.hp * (1 + currentWave * 0.2),
                speed: cfg.speed,
                damage: cfg.damage,
                exp: cfg.exp,
                type: cfg.type,
                lastAttack: 0
            });
        }

        function spawnHitParticles(pos, color = 0xff3333) {
            for (let i = 0; i < 8; i++) {
                const geo = new THREE.BoxGeometry(0.2, 0.2, 0.2);
                const mat = new THREE.MeshBasicMaterial({ color });
                const p = new THREE.Mesh(geo, mat);
                p.position.copy(pos);
                p.position.x += (Math.random() - 0.5) * 0.5;
                p.position.y += Math.random() * 1.5;
                p.position.z += (Math.random() - 0.5) * 0.5;
                
                const vel = new THREE.Vector3(
                    (Math.random() - 0.5) * 8,
                    Math.random() * 6 + 2,
                    (Math.random() - 0.5) * 8
                );
                
                scene.add(p);
                particles.push({ mesh: p, vel, life: 0.4 });
            }
        }

        function spawnCoin(pos) {
            const geo = new THREE.CylinderGeometry(0.4, 0.4, 0.15, 8);
            const mat = new THREE.MeshToonMaterial({ color: 0xffcc00, emissive: 0x443300 });
            const coin = new THREE.Mesh(geo, mat);
            coin.position.copy(pos);
            coin.position.y = 0.5;
            coin.rotation.x = Math.PI / 2;
            coin.castShadow = true;
            scene.add(coin);
            coinsList.push(coin);
        }

        function showDamageNumber(pos, amount) {
            const vec = pos.clone();
            vec.y += 2.5;
            vec.project(camera);

            const x = (vec.x * 0.5 + 0.5) * window.innerWidth;
            const y = (-(vec.y * 0.5) + 0.5) * window.innerHeight;

            const el = document.createElement('div');
            el.className = 'damage-number';
            el.innerText = `-${Math.round(amount)}`;
            el.style.left = `${x}px`;
            el.style.top = `${y}px`;

            document.getElementById('damage-container').appendChild(el);
            setTimeout(() => el.remove(), 800);
        }

        function setupInputs() {
            window.addEventListener('keydown', (e) => {
                const k = e.key.toLowerCase();
                if (k === 'w' || k === 'arrowup') keys.w = true;
                if (k === 'a' || k === 'arrowleft') keys.a = true;
                if (k === 's' || k === 'arrowdown') keys.s = true;
                if (k === 'd' || k === 'arrowright') keys.d = true;
                if (e.code === 'Space') performAttack();
            });

            window.addEventListener('keyup', (e) => {
                const k = e.key.toLowerCase();
                if (k === 'w' || k === 'arrowup') keys.w = false;
                if (k === 'a' || k === 'arrowleft') keys.a = false;
                if (k === 's' || k === 'arrowdown') keys.s = false;
                if (k === 'd' || k === 'arrowright') keys.d = false;
            });

            // Camera Mouse Drag Controls
            window.addEventListener('mousedown', (e) => {
                if (e.target.tagName === 'CANVAS') {
                    isMouseDown = true;
                    mouseLook.x = e.clientX;
                    mouseLook.y = e.clientY;
                }
            });

            window.addEventListener('mousemove', (e) => {
                if (isMouseDown) {
                    const dx = e.clientX - mouseLook.x;
                    const dy = e.clientY - mouseLook.y;
                    cameraAngleX -= dx * 0.005;
                    cameraAngleY = Math.max(0.1, Math.min(Math.PI / 2.2, cameraAngleY + dy * 0.005));
                    mouseLook.x = e.clientX;
                    mouseLook.y = e.clientY;
                }
            });

            window.addEventListener('mouseup', () => isMouseDown = false);

            // Mobile Virtual Joystick Setup
            const joyZone = document.getElementById('joystick-zone');
            const joyKnob = document.getElementById('joystick-knob');
            let joyTouchId = null;

            if ('ontouchstart' in window) {
                joyZone.style.display = 'block';
                document.getElementById('mobile-buttons').classList.remove('hidden');
            }

            joyZone.addEventListener('touchstart', (e) => {
                e.preventDefault();
                const touch = e.changedTouches[0];
                joyTouchId = touch.identifier;
            });

            joyZone.addEventListener('touchmove', (e) => {
                e.preventDefault();
                for (let touch of e.changedTouches) {
                    if (touch.identifier === joyTouchId) {
                        const rect = joyZone.getBoundingClientRect();
                        const centerX = rect.left + rect.width / 2;
                        const centerY = rect.top + rect.height / 2;
                        let dx = touch.clientX - centerX;
                        let dy = touch.clientY - centerY;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        const maxR = 40;

                        if (dist > maxR) {
                            dx = (dx / dist) * maxR;
                            dy = (dy / dist) * maxR;
                        }

                        joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
                        joystickVector.x = dx / maxR;
                        joystickVector.y = dy / maxR;
                    }
                }
            });

            const resetJoystick = (e) => {
                for (let touch of e.changedTouches) {
                    if (touch.identifier === joyTouchId) {
                        joyTouchId = null;
                        joyKnob.style.transform = 'translate(0px, 0px)';
                        joystickVector = { x: 0, y: 0 };
                    }
                }
            };

            joyZone.addEventListener('touchend', resetJoystick);
            joyZone.addEventListener('touchcancel', resetJoystick);

            document.getElementById('btn-attack').addEventListener('click', () => performAttack());
            document.getElementById('btn-jump').addEventListener('click', () => performAttack());
        }

        function performAttack() {
            if (gameState !== 'PLAYING') return;
            const now = clock.getElapsedTime();
            if (now - lastAttackTime < 1.0 / attackSpeed) return;
            
            lastAttackTime = now;
            sfx.playSwing();

            // Swing Right Arm Animation
            rightArm.rotation.x = -Math.PI / 1.5;

            // Damage nearby enemies in front
            const playerDir = new THREE.Vector3(0, 0, -1).applyQuaternion(player.quaternion);

            enemies.forEach(enemy => {
                const toEnemy = new THREE.Vector3().subVectors(enemy.mesh.position, player.position);
                const dist = toEnemy.length();

                if (dist <= attackRange) {
                    const angle = playerDir.angleTo(toEnemy.normalize());
                    if (angle < Math.PI / 2) { // 180 degree cone
                        enemy.hp -= attackPower;
                        sfx.playHit();
                        spawnHitParticles(enemy.mesh.position);
                        showDamageNumber(enemy.mesh.position, attackPower);

                        if (enemy.hp <= 0) {
                            // Defeated
                            spawnCoin(enemy.mesh.position);
                            addExp(enemy.exp);
                            sessionKills++;
                        }
                    }
                }
            });
        }

        function addExp(amount) {
            playerExp += amount;
            if (playerExp >= expToNextLevel) {
                playerExp -= expToNextLevel;
                playerLevel++;
                expToNextLevel = Math.floor(expToNextLevel * 1.4);
                sfx.playLevelUp();
                triggerLevelUpModal();
            }
            updateHUD();
        }

        function triggerLevelUpModal() {
            gameState = 'LEVELUP';
            const container = document.getElementById('cards-container');
            container.innerHTML = '';

            const upgrades = [
                { title: '⚔️ Sharp Edge', desc: '+25% Damage', apply: () => attackPower *= 1.25 },
                { title: '⚡ Fast Swing', desc: '+30% Attack Speed', apply: () => attackSpeed *= 1.3 },
                { title: '👟 Speed Boost', desc: '+20% Move Speed', apply: () => moveSpeed *= 1.2 },
                { title: '❤️ Big Heart', desc: '+50 Max HP & Full Heal', apply: () => { playerMaxHp += 50; playerHp = playerMaxHp; } },
                { title: '🗡️ Reach Upgrade', desc: '+25% Attack Range', apply: () => attackRange *= 1.25 }
            ];

            // Pick 3 random cards
            const shuffled = upgrades.sort(() => 0.5 - Math.random()).slice(0, 3);

            shuffled.forEach(card => {
                const cardEl = document.createElement('div');
                cardEl.className = 'roblox-panel p-4 rounded-xl border border-yellow-500/50 hover:border-yellow-400 cursor-pointer transition transform hover:-translate-y-1 flex flex-col justify-between items-center text-center';
                cardEl.innerHTML = `
                    <div class="text-2xl mb-2">${card.title}</div>
                    <div class="text-sm font-bold text-yellow-300 mb-4">${card.desc}</div>
                    <button class="roblox-btn-green py-2 px-4 rounded-lg roblox-font text-sm text-white w-full">SELECT</button>
                `;
                cardEl.onclick = () => {
                    card.apply();
                    document.getElementById('levelup-modal').classList.add('hidden');
                    gameState = 'PLAYING';
                    updateHUD();
                };
                container.appendChild(cardEl);
            });

            document.getElementById('levelup-modal').classList.remove('hidden');
        }

        function updateHUD() {
            document.getElementById('hud-username').innerText = playerName;
            document.getElementById('hud-level').innerText = `Lv. ${playerLevel}`;
            document.getElementById('coin-count').innerText = playerCoins;
            document.getElementById('hud-wave').innerText = currentWave;

            const hpPct = Math.max(0, (playerHp / playerMaxHp) * 100);
            document.getElementById('hp-bar').style.width = `${hpPct}%`;

            const expPct = Math.min(100, (playerExp / expToNextLevel) * 100);
            document.getElementById('exp-bar').style.width = `${expPct}%`;
        }

        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();
            const time = clock.getElapsedTime();

            if (gameState === 'PLAYING') {
                // Player Movement Physics
                let moveX = 0, moveZ = 0;

                if (keys.w) moveZ -= 1;
                if (keys.s) moveZ += 1;
                if (keys.a) moveX -= 1;
                if (keys.d) moveX += 1;

                // Touch Joystick overrides keyboard
                if (Math.abs(joystickVector.x) > 0.1 || Math.abs(joystickVector.y) > 0.1) {
                    moveX = joystickVector.x;
                    moveZ = joystickVector.y;
                }

                const moveDir = new THREE.Vector3(moveX, 0, moveZ);
                if (moveDir.length() > 0.1) {
                    moveDir.normalize();

                    // Relative to camera Y rotation
                    const camYRot = cameraAngleX;
                    const rotatedX = moveDir.x * Math.cos(camYRot) + moveDir.z * Math.sin(camYRot);
                    const rotatedZ = -moveDir.x * Math.sin(camYRot) + moveDir.z * Math.cos(camYRot);

                    player.position.x += rotatedX * moveSpeed * delta;
                    player.position.z += rotatedZ * moveSpeed * delta;

                    // Bound player within map
                    const limit = 55;
                    player.position.x = Math.max(-limit, Math.min(limit, player.position.x));
                    player.position.z = Math.max(-limit, Math.min(limit, player.position.z));

                    // Rotate Player towards movement
                    const targetAngle = Math.atan2(rotatedX, rotatedZ);
                    player.rotation.y = targetAngle;

                    // Walking Limb Swing Animation
                    const walkSpeed = 12;
                    leftArm.rotation.x = Math.sin(time * walkSpeed) * 0.7;
                    if (time - lastAttackTime > 0.4) {
                        rightArm.rotation.x = -Math.sin(time * walkSpeed) * 0.7;
                    }
                    leftLeg.rotation.x = -Math.sin(time * walkSpeed) * 0.7;
                    rightLeg.rotation.x = Math.sin(time * walkSpeed) * 0.7;
                } else {
                    // Idle Pose
                    leftArm.rotation.x = THREE.MathUtils.lerp(leftArm.rotation.x, 0, 0.1);
                    if (time - lastAttackTime > 0.4) {
                        rightArm.rotation.x = THREE.MathUtils.lerp(rightArm.rotation.x, 0, 0.1);
                    }
                    leftLeg.rotation.x = THREE.MathUtils.lerp(leftLeg.rotation.x, 0, 0.1);
                    rightLeg.rotation.x = THREE.MathUtils.lerp(rightLeg.rotation.x, 0, 0.1);
                }

                // Wave Spawning Controller
                if (enemies.length < 5 + currentWave * 3) {
                    spawnEnemy();
                }

                // Enemy AI Behavior
                for (let i = enemies.length - 1; i >= 0; i--) {
                    const enemy = enemies[i];
                    if (enemy.hp <= 0) {
                        scene.remove(enemy.mesh);
                        enemies.splice(i, 1);
                        continue;
                    }

                    // Look & Chase Player
                    enemy.mesh.lookAt(player.position.x, enemy.mesh.position.y, player.position.z);
                    const dir = new THREE.Vector3().subVectors(player.position, enemy.mesh.position);
                    dir.y = 0;
                    const dist = dir.length();

                    if (dist > 1.8) {
                        dir.normalize();
                        enemy.mesh.position.addScaledVector(dir, enemy.speed * delta);
                        // Enemy walk animation
                        const legs = enemy.mesh.children[0].children; // Legs/arms
                    } else {
                        // Attack Player
                        if (time - enemy.lastAttack > 1.2) {
                            enemy.lastAttack = time;
                            playerHp -= enemy.damage;
                            sfx.playHit();
                            updateHUD();

                            if (playerHp <= 0) {
                                gameOver();
                            }
                        }
                    }
                }

                // Coins Collection Pickup
                for (let i = coinsList.length - 1; i >= 0; i--) {
                    const c = coinsList[i];
                    c.rotation.z += delta * 4;
                    const dist = player.position.distanceTo(c.position);
                    if (dist < 2.5) {
                        playerCoins += 5;
                        totalCoins += 5;
                        localStorage.setItem('blox_coins', totalCoins);
                        sfx.playCoin();
                        scene.remove(c);
                        coinsList.splice(i, 1);
                        updateHUD();
                    }
                }

                // Particles Physics Updates
                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];
                    p.life -= delta;
                    p.mesh.position.addScaledVector(p.vel, delta);
                    p.vel.y -= 15 * delta; // Gravity
                    if (p.life <= 0) {
                        scene.remove(p.mesh);
                        particles.splice(i, 1);
                    }
                }

                // Increase Wave Level gradually
                if (sessionKills > currentWave * 10) {
                    currentWave++;
                    updateHUD();
                }
            }

            // Smooth Camera Follow Logic
            if (player) {
                const targetCamX = player.position.x + cameraDistance * Math.sin(cameraAngleX) * Math.cos(cameraAngleY);
                const targetCamY = player.position.y + cameraDistance * Math.sin(cameraAngleY) + 2;
                const targetCamZ = player.position.z + cameraDistance * Math.cos(cameraAngleX) * Math.cos(cameraAngleY);

                camera.position.x = THREE.MathUtils.lerp(camera.position.x, targetCamX, 0.1);
                camera.position.y = THREE.MathUtils.lerp(camera.position.y, targetCamY, 0.1);
                camera.position.z = THREE.MathUtils.lerp(camera.position.z, targetCamZ, 0.1);

                camera.lookAt(player.position.x, player.position.y + 2, player.position.z);
            }

            renderer.render(scene, camera);
        }

        function gameOver() {
            gameState = 'GAMEOVER';
            sfx.playOof();

            document.getElementById('final-wave').innerText = currentWave;
            document.getElementById('final-kills').innerText = sessionKills;
            document.getElementById('final-coins').innerText = playerCoins;

            // Save High Score Leaderboard
            saveScore(playerName, sessionKills, currentWave);

            document.getElementById('gameover-modal').classList.remove('hidden');
        }

        function saveScore(name, kills, wave) {
            const scores = JSON.parse(localStorage.getItem('blox_leaderboard') || '[]');
            scores.push({ name, kills, wave, date: new Date().toLocaleDateString() });
            scores.sort((a, b) => b.kills - a.kills);
            localStorage.setItem('blox_leaderboard', JSON.stringify(scores.slice(0, 5)));
        }

        function renderLeaderboard() {
            const scores = JSON.parse(localStorage.getItem('blox_leaderboard') || '[]');
            const list = document.getElementById('leaderboard-list');
            if (scores.length === 0) {
                list.innerHTML = '<div>No records yet! Be the first!</div>';
                return;
            }
            list.innerHTML = scores.map((s, i) => `
                <div class="flex justify-between">
                    <span>#${i+1} <b>${s.name}</b></span>
                    <span class="text-yellow-400">${s.kills} Kills (Wave ${s.wave})</span>
                </div>
            `).join('');
        }

        function renderShop() {
            const grid = document.getElementById('shop-grid');
            grid.innerHTML = '';

            SKINS.forEach(skin => {
                const isSelected = selectedSkin.id === skin.id;
                const card = document.createElement('div');
                card.className = `p-3 rounded-xl border flex flex-col items-center justify-between text-xs font-bold ${
                    isSelected ? 'border-green-400 bg-green-900/30' : 'border-gray-700 bg-gray-800/80'
                }`;

                card.innerHTML = `
                    <div class="w-10 h-10 rounded-lg mb-2 flex items-center justify-center border text-lg" style="background-color: #${skin.torsoColor.toString(16).padStart(6,'0')}">
                        🙂
                    </div>
                    <div class="text-white mb-1">${skin.name}</div>
                    ${skin.unlocked ? 
                        `<button class="w-full py-1 rounded roblox-btn ${isSelected ? 'opacity-50' : ''}">${isSelected ? 'EQUIPPED' : 'EQUIP'}</button>` : 
                        `<button class="w-full py-1 rounded roblox-btn-gold">🪙 ${skin.price}</button>`
                    }
                `;

                card.onclick = () => {
                    if (skin.unlocked) {
                        selectedSkin = skin;
                        rebuildPlayerSkin();
                        renderShop();
                    } else if (totalCoins >= skin.price) {
                        totalCoins -= skin.price;
                        skin.unlocked = true;
                        selectedSkin = skin;
                        localStorage.setItem('blox_coins', totalCoins);
                        rebuildPlayerSkin();
                        renderShop();
                    } else {
                        alert('Not enough coins!');
                    }
                };

                grid.appendChild(card);
            });
        }

        function rebuildPlayerSkin() {
            if (!player) return;
            scene.remove(player);
            player = createRobloxCharacter(selectedSkin.headColor, selectedSkin.torsoColor, selectedSkin.limbColor);
            scene.add(player);
        }

        function resetGame() {
            // Clear enemies & objects
            enemies.forEach(e => scene.remove(e.mesh));
            enemies = [];
            coinsList.forEach(c => scene.remove(c));
            coinsList = [];

            // Reset stats
            playerHp = 100;
            playerMaxHp = 100;
            playerLevel = 1;
            playerExp = 0;
            expToNextLevel = 100;
            playerCoins = 0;
            sessionKills = 0;
            currentWave = 1;
            attackPower = 25;
            attackSpeed = 1.0;
            moveSpeed = 12;

            if (player) player.position.set(0, 0, 0);

            updateHUD();
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        window.onload = () => {
            initScene();
            renderLeaderboard();
            renderShop();

            // Menu Button Handlers
            document.getElementById('start-game-btn').addEventListener('click', () => {
                sfx.init();
                const nameInput = document.getElementById('player-name-input').value.trim();
                if (nameInput) playerName = nameInput;

                document.getElementById('main-menu').classList.add('hidden');
                document.getElementById('hud-top').classList.remove('hidden');

                resetGame();
                gameState = 'PLAYING';
            });

            document.getElementById('open-shop-btn').addEventListener('click', () => {
                renderShop();
                document.getElementById('shop-modal').classList.remove('hidden');
            });

            document.getElementById('close-shop-btn').addEventListener('click', () => {
                document.getElementById('shop-modal').classList.add('hidden');
            });

            document.getElementById('restart-btn').addEventListener('click', () => {
                document.getElementById('gameover-modal').classList.add('hidden');
                resetGame();
                gameState = 'PLAYING';
            });

            // Start Animation Frame Loop
            animate();
        };
    </script>
</body>
</html>
